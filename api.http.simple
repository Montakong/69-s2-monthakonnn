# REST

## Variables
@admin_email = {{$dotenv ADMIN_EMAIL}}
@admin_password = {{$dotenv ADMIN_PASSWORD}}
@user_identifier = {{$dotenv USER_IDENTIFIER}}
@user_password = {{$dotenv USER_PASSWORD}}

## 1.Admin
### 1.1 Login
POST http://localhost:9192/admin/login
Content-Type: application/json

{
    "email": "{{admin_email}}",
    "password": "{{admin_password}}",
    "rememberMe": false
}

### 1.2 Register
POST http://localhost:9192/admin/register
Content-Type: application/json

{
    "registrationToken": "",
    "userInfo": {
        "firstname": "",
        "lastname": "",
        "password": "{{admin_password}}"
    }
}

### 1.3 Forgot Password
POST http://localhost:9192/admin/forgot-password
Content-Type: application/json

{
    "email": "{{admin_email}}"
}

### 1.3.1 Reset Password
POST http://localhost:9192/admin/reset-password
Content-Type: application/json

{
    "resetPasswordToken": "",
    "password": "{{admin_password}}"
}

### 1.4 Profile
GET http://localhost:9192/admin/users/me
Authorization: Bearer

### 1.4.1 Update Profile
PUT http://localhost:9192/admin/users/me
Content-Type: application/json
Authorization: Bearer

{
    "firstname": "",
    "lastname": "",
    "email": "{{admin_email}}"
}

## 2.User
### 2.1 Login
POST http://localhost:9192/api/auth/local
Content-Type: application/json

{
    "identifier": "{{user_identifier}}",
    "password": "{{user_password}}"
}

### 2.2 Register
POST http://localhost:9192/api/auth/local/register
Content-Type: application/json

{
    "username": "",
    "email": "{{user_identifier}}",
    "password": "{{user_password}}"
}

### 2.3 Forgot Password
POST http://localhost:9192/api/auth/forgot-password
Content-Type: application/json

{
    "email": "{{user_identifier}}"
}

### 2.3.1 Reset Password
POST http://localhost:9192/api/auth/reset-password
Content-Type: application/json

{
    "code": "",
    "password": "{{user_password}}",
    "passwordConfirmation": "{{user_password}}"
}

### 2.4 Profile
GET http://localhost:9192/api/users/me
Authorization: Bearer

### 2.4.1 Update Profile
PUT http://localhost:9192/api/users/me
Content-Type: application/json
Authorization: Bearer

{
    "username": "",
    "email": "{{user_identifier}}"
}
